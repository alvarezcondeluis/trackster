# Copy this file to `.env` and fill in your own values. `.env` is gitignored.

# --- Kaggle (needed to download the dataset) -------------------------------
# Get a token at https://www.kaggle.com/settings -> API -> "Create New Token".
# Either set these two vars, OR drop kaggle.json at ~/.kaggle/kaggle.json.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Supabase (needed later, to store the songs) ---------------------------
SUPABASE_URL=
SUPABASE_KEY=
# Optional: service-role key (Settings → API → service_role). Server-side only —
# lets the backend write cached album art to Storage, bypassing RLS. Never expose
# this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Spotify Frontend (needed for Web Playback SDK) --------------------------
# Get from: https://developer.spotify.com/dashboard → Your app
# 1. Click your app
# 2. Copy "Client ID" (NOT the secret - that stays on backend!)
VITE_SPOTIFY_CLIENT_ID=

# --- Spotify Backend (needed to fetch preview URLs) --------------------------
# Backend only - NEVER expose this to frontend!
# Get from: https://developer.spotify.com/dashboard → Your app
# 1. Click your app
# 2. Copy "Client ID" and "Client Secret"
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
