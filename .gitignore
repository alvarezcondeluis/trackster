# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Data (downloaded / generated — do not commit large files)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# EDA outputs
reports/
.ipynb_checkpoints/
node_modules

# Build output (Vite / Nitro / Wrangler)
.output/
.wrangler/
.vite/

# Editor / OS junk
.vscode/
.idea/
.DS_Store

# Python tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Logs & extra env files (keep an example if you add one)
*.log
.env.*
!.env.example
